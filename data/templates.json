              "helpIcon": "MvChats",
              "helpTitle": "Have Questions?",
              "helpText": "Here are some of the most\ncommon questions our guests\nask before planning their stay\nat Miravana.",
              "items": [
                {
                  "id": "check-in",
                  "question": "What are the check-in and check-out times?",
                  "answer": "Check-in is from 2:00 PM onwards, and check-out is by 11:00 AM. Early check-in or late check-out\nmay be available upon request, subject to availability."
                },
                {
                  "id": "transport",
                  "question": "Do you offer airport or local transportation?",
                  "answer": "Yes. We arrange airport pick-up and drop-off as well as local transfers and day trips. Share your flight details when you book and our team will plan the rest."
                },
                {
                  "id": "meals",
                  "question": "Are meals included in the stay?",
                  "answer": "Breakfast is included with every room. Half-board and full-board plans, in-room dining and private dinners can be added to any booking."
                },
                {
                  "id": "family",
                  "question": "Is the property family-friendly?",
                  "answer": "Absolutely. We offer family rooms and villas, extra beds and cots, a kids’ pool and activities, and babysitting on request."
                },
                {
                  "id": "booking",
                  "question": "Can I modify or cancel my booking?",
                  "answer": "Yes. Most bookings can be changed or cancelled free of charge up to 48 hours before arrival. Special offers may have their own terms, shown when you book."
                }
              ]
            }
          }
